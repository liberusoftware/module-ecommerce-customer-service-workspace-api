{
    "name": "liberusoftware/ecommerce-customer-service-workspace-api",
    "description": "HTTP adapter over the customer service workspace module: the queue an agent works, the conversation a customer resumes with the claim they were issued, the transcript, the notes, the assembled timeline and the service quality measured about all of it.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": [
        "laravel",
        "ecommerce",
        "customer-service",
        "support",
        "api",
        "liberu"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-customer-service-workspace"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/config": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "liberusoftware/ecommerce-customer-service-workspace": "^0.1"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\CustomerServiceWorkspace\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\CustomerServiceWorkspace\\Api\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-customer-service-workspace-api"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
